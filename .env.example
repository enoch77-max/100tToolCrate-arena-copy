# Copy to .env for local use, or /etc/100toolcrate/env on the VPS.
NODE_ENV=production
HOST=127.0.0.1
PORT=3000
PUBLIC_ORIGIN=https://100toolcrate.com

# Nginx runs on the same VPS. Do not use "true" unless every proxy is trusted.
TRUST_PROXY=loopback

# Absolute path outside every public static directory. Parent must be writable.
DATABASE_PATH=/var/www/100toolcrate/data/toolcrate.db
BACKUP_DIR=/var/www/100toolcrate/backups
BACKUP_RETENTION_DAYS=14

LOG_LEVEL=info
SHUTDOWN_TIMEOUT_MS=10000
TRACK_RATE_LIMIT=120
READ_RATE_LIMIT=240

# Optional override. Otherwise the generator derives the publisher from ads.txt.
# ADSENSE_CLIENT_ID=ca-pub-5986395187107423

# Phase 2/3 payment, mail and owner-auth secrets are intentionally not defined yet.
